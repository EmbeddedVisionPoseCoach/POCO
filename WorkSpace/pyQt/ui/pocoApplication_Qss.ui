  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background-color: #F6F8FC;
}
QWidget#centralwidget,
QWidget#tabMain,
QWidget#tabSettings,
QWidget#settingsScrollContent {
    background-color: #F6F8FC;
}
QTabWidget::pane {
    border: 1px solid #DCE5F0;
    border-radius: 10px;
    background: #FFFFFF;
    top: -1px;
}
QTabBar::tab {
    background: #EEF3FA;
    color: #64748B;
    border: 1px solid #DCE5F0;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    min-width: 82px;
    min-height: 22px;
    padding: 2px 10px;
    font-size: 9pt;
    font-weight: 800;
}
QTabBar::tab:selected {
    background: #FFFFFF;
    color: #1D4ED8;
}
QFrame#headerFrame,
QFrame#controlFrame,
QFrame#rankFrame,
QFrame#cameraFrame,
QFrame#infoFrame,
QFrame#settingsCard,
QFrame#settingHelpFrame {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
}
QFrame#rankFrame,
QFrame#cameraFrame {
    background-color: #FBFDFF;
}
QLabel {
    color: #263445;
    background: transparent;
    font-size: 9pt;
}
QLabel#labelTitle {
    color: #111827;
    font-size: 13pt;
    font-weight: 900;
}
QLabel#labelStatus {
    color: #2563EB;
    font-size: 9pt;
    font-weight: 800;
}
QLabel#sectionTitleControl,
QLabel#sectionTitleRank,
QLabel#sectionTitleInfo,
QLabel#settingsTitle,
QLabel#settingsHelpTitle {
    color: #111827;
    font-size: 10pt;
    font-weight: 900;
}
QLabel#label {
    background-color: #EEF3FA;
    border: 1px dashed #B7C6D8;
    border-radius: 10px;
    color: #64748B;
    font-size: 10pt;
    font-weight: 800;
}
QLabel#label_Rank {
    background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    padding: 8px 10px;
    color: #1E293B;
    font-size: 10pt;
    font-weight: 800;
    line-height: 150%;
}
QLabel#label_CurrentPose {
    background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    color: #111827;
    font-size: 11pt;
    font-weight: 800;
    padding: 5px;
}
QLabel#label_totalsec {
    background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    color: #111827;
    font-size: 10pt;
    font-weight: 800;
    padding: 5px;
}
QLabel#labelSensorMonitor {
    background-color: #F8FAFC;
    border: 1px solid #CBD5E1;
    border-radius: 7px;
    color: #334155;
    font-size: 8pt;
    font-weight: 700;
    padding: 2px 5px;
}
QPushButton {
    background-color: #2563EB;
    color: white;
    border: none;
    border-radius: 9px;
    padding: 6px 8px;
    font-size: 9pt;
    font-weight: 900;
}
QPushButton:hover {
    background-color: #1D4ED8;
}
QPushButton:pressed {
    background-color: #1E40AF;
}

QPushButton#btnCalibration {
    background-color: #6366F1;
}
QPushButton#btnCalibration:hover {
    background-color: #4F46E5;
}
QPushButton#btnCalibration:pressed {
    background-color: #4338CA;
}
QPushButton#btnCalibrationStart {
    background-color: #14B8A6;
}
QPushButton#btnCalibrationStart:hover {
    background-color: #0D9488;
}
QPushButton#btnCalibrationStart:pressed {
    background-color: #0F766E;
}
QPushButton#btnCamOff {
    background-color: #EF4444;
}
QPushButton#btnCamOff:hover {
    background-color: #DC2626;
}
QPushButton#btnReport,
QPushButton#btnSaveSettings {
    background-color: #0F766E;
}
QPushButton#btnReport:hover,
QPushButton#btnSaveSettings:hover {
    background-color: #0D9488;
}
QCheckBox {
    color: #1F2937;
    font-size: 10pt;
    font-weight: 800;
    spacing: 8px;
}
QSpinBox,
QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 4px 8px;
    min-height: 24px;
    color: #111827;
    font-size: 9pt;
    font-weight: 700;
}
QScrollArea {
    border: none;
    background: transparent;
}
QLabel#settingsHelpText {
    color: #475569;
    font-size: 9pt;
    line-height: 150%;
}
